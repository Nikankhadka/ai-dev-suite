{
  "$schema": "https://opencode.ai/config.json",

  // Every skill listed here costs description tokens in every prompt, so the
  // list is curated. Deliberately absent:
  //   - taste-skill and hallmark: skills/frontend-design/SKILL.md loads them by
  //     file path on demand, so registering them buys nothing.
  //   - mattpocock in-progress: unblessed upstream work.
  // scripts/link-skills.sh must stay in sync with this list.
  "skills": {
    "paths": [
      "./vendor/mattpocock-skills/skills/engineering",
      "./vendor/mattpocock-skills/skills/productivity",
      "./vendor/mattpocock-skills/skills/misc",
      "./vendor/lavish-axi/skills",
      "./vendor/no-mistakes/skills",
      "./vendor/gnhf/skills",
      "./vendor/axi/.agents/skills",
      "./vendor/firstmate/skills",
      "./vendor/ponytail/skills",
      "./skills"
    ]
  },

  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git branch -D *": "deny",
      "git clean -fd *": "deny",
      "*": "allow"
    }
  }
}
