{
  "$schema": "https://opencode.ai/config.json",

  "skills": {
    "paths": [
      "./vendor/mattpocock-skills/skills/engineering",
      "./vendor/mattpocock-skills/skills/productivity",
      "./vendor/mattpocock-skills/skills/misc",
      "./vendor/mattpocock-skills/skills/in-progress",
      "./skills"
    ]
  },

  "mcp": {
    "servers": {
      "github": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"]
      }
    }
  },

  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Task",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(git clean -fd:*)"
    ]
  }
}
