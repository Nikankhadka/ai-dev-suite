{
  "$schema": "https://opencode.ai/config.json",

  "skills": {
    "paths": [
      "./vendor/mattpocock-skills/skills/engineering",
      "./vendor/mattpocock-skills/skills/productivity",
      "./vendor/mattpocock-skills/skills/misc",
      "./vendor/mattpocock-skills/skills/in-progress",
      "./skills"
    ]
  },

  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git branch -D *": "deny",
      "git clean -fd *": "deny",
      "*": "allow"
    }
  }
}
